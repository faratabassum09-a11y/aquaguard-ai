# Copy this file to .env and fill in your values

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/aquaguard

# Port for the Express server
PORT=5000

# Optional: enables real LLM-generated explanations / action plans.
# If left blank, AQUAGUARD falls back to a built-in templated explanation
# engine so the app still works fully offline for a demo, at zero cost.
#
# Supported providers - pick ONE:
#   "gemini"    -> Google Gemini via Google AI Studio. Genuinely free tier,
#                  NO credit card required. Get a key at https://aistudio.google.com/apikey
#                  Recommended if you don't want to enter any payment details.
#   "anthropic" -> Claude. Usually needs a card on file (small free trial credit on signup).
#   "openai"    -> GPT. Usually needs a card on file (small free trial credit on signup).
#   ""          -> leave blank to use the free built-in template engine, no key needed at all.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
# If using anthropic, set LLM_MODEL=claude-sonnet-4-6
# If using openai, set LLM_MODEL=gpt-4o-mini
# Gemini model names change fairly often - if you get a "model no longer
# available" error, the error message itself tells you the current
# replacement name to use (e.g. it told one of our users to switch to
# gemini-3.6-flash). Just paste whatever name the error suggests.

# Optional: enables real WhatsApp/SMS critical alerts via Twilio.
# If left blank, AQUAGUARD logs a clearly-labeled SIMULATED send instead,
# so the subscribe -> critical -> "delivered" flow still demos end to end
# without a Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional but often REQUIRED for WhatsApp on newer/stricter Twilio accounts:
# some accounts now reject plain free-text WhatsApp sends entirely ("ContentSid
# Required") and demand a pre-approved Content Template, even mid-session.
# If you hit that error, create a simple template in Twilio Console under
# Content Template Builder with a single body variable (e.g. body: "{{1}}"),
# then paste its SID (starts with HX...) here. AQUAGUARD will then send your
# real alert text through that template's {{1}} slot, keeping the message
# fully custom instead of falling back to Twilio's fixed sample templates.
TWILIO_CONTENT_SID=

# Optional but RECOMMENDED: enables real email alerts via Gmail - the
# easiest "real" delivery channel to light up, since it needs no phone
# verification, no message-template approval, and no telecom compliance
# registration (unlike SMS/WhatsApp in some countries, e.g. India's TRAI
# sender-registration rules). If left blank, email alerts are logged as a
# clearly-labeled SIMULATED send instead.
#
# To get an App Password (free, no billing):
#   1. Enable 2-Step Verification on your Google account (myaccount.google.com/security)
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password for "Mail" and paste the 16-character code below
#      (NOT your regular Gmail password - that will not work)
EMAIL_USER=
EMAIL_APP_PASSWORD=
